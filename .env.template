# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Comma-separated Telegram user IDs allowed to use this bot
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Path to credentials JSON downloaded from Google Cloud Console (Desktop app type)
GOOGLE_CREDENTIALS_FILE=/app/credentials/google_credentials.json
# Token file written by setup_auth.py (persisted in data/ volume)
GOOGLE_TOKEN_FILE=/app/data/google_token.json

# ── Storage paths (match docker-compose volumes) ──────────────────────────────
DB_PATH=/app/data/assistant.db
CHROMA_PATH=/app/data/chroma
WHISPER_MODEL_PATH=/app/data/whisper

# ── Scheduler ─────────────────────────────────────────────────────────────────
BRIEFING_TIME=08:00          # HH:MM in the timezone below
TIMEZONE=Europe/London       # Any valid pytz timezone string

# ── Tuning ────────────────────────────────────────────────────────────────────
WHISPER_MODEL=base           # base | small | medium (larger = better but slower)
CONVERSATION_WINDOW=30       # Number of messages kept in Claude context
